# URL pública do Backend_CardioIA hospedado no Render (R1.5).
# Em produção (Vercel), configure esta variável no painel do projeto.
# Substitua <seu-servico> pelo nome do Web Service criado no Render.
# Localmente, use http://127.0.0.1:8000
VITE_API_URL=https://<seu-servico>.onrender.com

